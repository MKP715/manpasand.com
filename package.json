{
  "name": "manpasand.com",
  "private": true,
  "type": "module",
  "description": "Static site for Manpasand Technical Services (served by GitHub Pages).",
  "scripts": {
    "build": "node src/build.mjs",
    "check": "node src/build.mjs --check",
